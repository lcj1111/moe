#!/usr/bin/env bash

# Project roots
export QTOPOMOE_ROOT="${QTOPOMOE_ROOT:-/home/k8s-ops/moe}"
export QTOPOMOE_ARTIFACTS="${QTOPOMOE_ARTIFACTS:-${QTOPOMOE_ROOT}/artifacts}"
export QTOPOMOE_CONFIGS="${QTOPOMOE_CONFIGS:-${QTOPOMOE_ROOT}/configs}"
export QTOPOMOE_PHASE0="${QTOPOMOE_PHASE0:-/home/k8s-ops/artifacts/q_topomoe_phase0}"

# Existing isolated serving environments; do not install into them during project bootstrap.
export QTOPOMOE_SGLANG_VENV="${QTOPOMOE_SGLANG_VENV:-/data/models/test/.sglang_env}"
export QTOPOMOE_VLLM_VENV="${QTOPOMOE_VLLM_VENV:-/data/models/test/vllm_env}"

# Model registry roots and currently available checkpoints.
export QTOPOMOE_MODEL_ROOT="${QTOPOMOE_MODEL_ROOT:-/data/models/test/models}"
export QTOPOMOE_FP8_MODEL="${QTOPOMOE_FP8_MODEL:-${QTOPOMOE_MODEL_ROOT}/Qwen--Qwen3.6-35B-A3B-FP8/snapshots/master}"
export QTOPOMOE_NVFP4_MODEL="${QTOPOMOE_NVFP4_MODEL:-${QTOPOMOE_MODEL_ROOT}/RedHatAI--Qwen3.6-35B-A3B-NVFP4/snapshots/master}"
export QTOPOMOE_BF16_MODEL="${QTOPOMOE_BF16_MODEL:-/home/k8s-ops/.cache/modelscope/models/Qwen--Qwen3.6-35B-A3B/snapshots/master}"
export QTOPOMOE_W4A16_MODEL="${QTOPOMOE_W4A16_MODEL:-${QTOPOMOE_ARTIFACTS}/checkpoints/qwen36-35b-a3b-w4a16}"

# CUDA 13 / SM120
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
export CUDACXX="${CUDACXX:-${CUDA_HOME}/bin/nvcc}"
export CUDA_DEVICE_ORDER="PCI_BUS_ID"
export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-12.0}"
export PATH="${CUDA_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# NCCL: default ERDMA/RoCE initialization is unstable on this host.
export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-1}"
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
# Do not force NCCL_NET globally. Set NCCL_NET=Socket only when a run still selects ERDMA.

# Reproducibility and process behavior
export PYTHONNOUSERSITE="${PYTHONNOUSERSITE:-1}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
export HF_HUB_DISABLE_TELEMETRY="${HF_HUB_DISABLE_TELEMETRY:-1}"

# Existing communication tools and topology-aware rank groups.
export QTOPOMOE_NCCL_TESTS="${QTOPOMOE_NCCL_TESTS:-/usr/local/nccl_tests_cuda_13.0/build}"
export QTOPOMOE_GPU_ORDER_NODE_TP2="${QTOPOMOE_GPU_ORDER_NODE_TP2:-0,2,1,3,4,6,5,7}"
export QTOPOMOE_GPU_ORDER_COMPACT="${QTOPOMOE_GPU_ORDER_COMPACT:-0,1,2,3,4,5,6,7}"
export QTOPOMOE_NUMA0_GPUS="${QTOPOMOE_NUMA0_GPUS:-0,1,2,3}"
export QTOPOMOE_NUMA1_GPUS="${QTOPOMOE_NUMA1_GPUS:-4,5,6,7}"
