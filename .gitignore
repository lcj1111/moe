# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments and local caches
.venv/
.cache/
env/local.env

# Build outputs
build/
dist/
*.so
*.o
*.a

# Third-party repositories
third_party/*
